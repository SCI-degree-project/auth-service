# === Output and build directories ===
/dist
/build
/node_modules

# === Logs ===
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# === OS-specific ===
.DS_Store
Thumbs.db

# === Coverage and test output ===
/coverage
/.nyc_output
/jest.config.js
/test-report.html

# === IDEs and editors ===
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# === VSCode config ===
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# === Env files (do NOT commit secrets) ===
.env
.env.development
.env.test
.env.production
.env.local
.env.*.local

# === Temp & cache ===
.temp
.tmp
.cache
/.eslintcache

# === Runtime data ===
pids
*.pid
*.seed
*.pid.lock

# === Diagnostic reports ===
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# === NestJS specific ===
.nest-cli.json

# === TypeScript ===
*.tsbuildinfo

# === Optional Docker ignore ===
.dockerignore

# === Firebase / Auth0 / sensitive files ===
firebase.json
auth0.config.json
